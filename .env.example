PORT=3000
# Comma-separated extra admin/site origins (optional)
# Origins must match the browser Origin header exactly (no trailing slash)
CORS_ALLOWED_ORIGINS=https://ousulqatar.com,https://www.ousulqatar.com
DATABASE_URL=postgresql://user:password@localhost:5432/OSOUL
JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_hex_64
IMAGE_UPLOAD_URL=https://st79068.ispot.cc/ousoul/upload.php
IMAGE_BASE_URL=https://st79068.ispot.cc
IMAGE_PATH=/ousoul/images
# WhatsApp Node OTP (Easypanel)
OTP_WHATSAPP_NODE_ENABLED=true
WHATSAPP_NODE_URL=https://amctag-whats.38f0fz.easypanel.host
WHATSAPP_NODE_TOKEN=your_jwt_from_node
WHATSAPP_NODE_CLIENT_ID=your_connected_client_id
WHATSAPP_NODE_DELIVERY=otp
WHATSAPP_NODE_TIMEOUT=35
WHATSAPP_NODE_CONNECT_TIMEOUT=5
WHATSAPP_NODE_PHONE_FORMAT=DIGITS
OTP_TTL_SECONDS=300
APP_REQUIRED_VERSION=1.2.0
APP_LATEST_VERSION=1.2.0
APP_FORCE_UPDATE=true
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.vesco.osoul
IOS_STORE_URL=https://apps.apple.com/qa/app/osoul/id6747296555?l=ar

# Firebase Cloud Messaging (required for push notifications)
# Paste the full service account JSON on one line, or set the path via your host env UI
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}
